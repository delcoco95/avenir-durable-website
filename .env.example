# Copiez ce fichier en « .env » et remplissez-le.
# Le fichier .env ne doit JAMAIS être envoyé sur GitHub (il est exclu par .gitignore).
# Sur l'hébergement, placez-le à la racine, à côté du dossier « www » (pas dedans).
#
# À la première connexion, l'administration oblige à choisir un nouveau mot de passe :
# le serveur remplace alors ADMIN_PASSWORD par ADMIN_PASSWORD_HASH (empreinte, illisible).
# Ensuite, NE renvoyez PAS ce fichier sur l'hébergement : vous remettriez l'ancien mot de passe.

ADMIN_USER=identifiant
ADMIN_PASSWORD=mot-de-passe-de-depart

# Ajouté automatiquement par l'administration :
# ADMIN_PASSWORD_HASH='$argon2id$…'
# ADMIN_TOTP_SECRET='…'   (double authentification ; supprimer cette ligne la désactive)

# Formulaire de contact (contact.php, hébergement PHP uniquement ; sur GitHub Pages, FormSubmit est utilisé)
# CONTACT_TO=avenirdurable@ecomail.fr
# Serveur d'envoi recommandé (sinon la fonction mail() de l'hébergeur est utilisée). Exemple OVH :
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=465
# SMTP_SECURE=ssl
# SMTP_USER=contact@avenirdurable.fr
# SMTP_PASSWORD=…
# SMTP_FROM=contact@avenirdurable.fr
