# ──────────────────────────────────────────────────────────────
# Variables d'environnement — copiez ce fichier en `.env`
# et remplacez les valeurs. Ne versionnez JAMAIS le fichier .env.
# ──────────────────────────────────────────────────────────────

# Connexion PostgreSQL (obligatoire)
DATABASE_URL=postgres://utilisateur:motdepasse@127.0.0.1:5432/avenir_durable

# Base dédiée aux tests automatisés (facultatif, utilisée par `npm test`)
TEST_DATABASE_URL=postgres://utilisateur:motdepasse@127.0.0.1:5432/avenir_durable_test

# URL publique du site, sans barre finale (sert au sitemap, aux balises Open Graph…)
SITE_URL=https://avenirdurable.fr

# Clé secrète aléatoire (32 octets hex minimum) : `openssl rand -hex 32`
# Sert à anonymiser les adresses IP (limitation de débit, preuve de consentement).
SESSION_SECRET=remplacer-par-une-valeur-aleatoire

# Dossier de stockage des médias téléversés (hors du dossier public)
UPLOAD_DIR=./storage/uploads

# Indexation par les moteurs de recherche. Laisser à false tant que le site
# n'est pas validé par l'association (préproduction / démonstration).
ALLOW_INDEXING=false

# ── Messagerie (facultatif) ───────────────────────────────────
# Sans SMTP, les demandes de contact sont enregistrées et consultables
# dans l'administration, mais aucune notification e-mail n'est envoyée.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Site Avenir Durable <ne-pas-repondre@avenirdurable.fr>"

# ── Création du premier compte administrateur (facultatif) ────
# Utilisé uniquement par `npm run admin:create` si les options ne sont pas
# passées en ligne de commande. Le mot de passe est généré aléatoirement.
ADMIN_EMAIL=
ADMIN_NAME=
